# Backend
DATABASE_URL=postgresql://nishant:nishant123@localhost:5434/nishant_infratech
FRONTEND_URL=http://localhost:5175
JWT_SECRET=change-this-to-a-random-secret
PORT=3002

# Frontend (Vite) - prefix with VITE_ so Vite exposes it
VITE_API_URL=http://localhost:3002/api

# Twilio WhatsApp (OTP delivery) — leave unset to keep WhatsApp sending disabled
# (in-app notification + free wa.me link still work either way).
# Get TWILIO_WHATSAPP_FROM from Twilio Console → "Try out WhatsApp" — it's
# account-specific, not the same number for everyone.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=

# Trial-account SMS workaround (server/lib/sms.ts) — leave unset once the
# account is upgraded; real OTP generation takes over automatically.
TWILIO_SMS_FROM=
